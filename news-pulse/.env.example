# Public URL of your deployment (used in notification links and share previews)
PUBLIC_URL=https://news.example.com
PORT=8080
DATA_DIR=./data

# Web Push (VAPID). Generate with: npm run vapid. If unset, keys are generated once and stored in DATA_DIR.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Poll intervals in seconds
GNEWS_INTERVAL_SEC=60
GDELT_INTERVAL_SEC=300
RSS_INTERVAL_SEC=120
X_INTERVAL_SEC=300

# Verification thresholds (see README)
VERIFIED_SCORE=4
VERIFIED_ORIGINS=3

# Notification hygiene
NOTIFY_MAX_AGE_MIN=180
NOTIFY_BURST_LIMIT=6

# Optional: official X API v2 (paid tier). Posts count only as signals unless from xOfficialHandles.
X_BEARER_TOKEN=

# Optional broadcast channels (verified stories by default)
CHANNEL_NOTIFY_LEVEL=verified
NTFY_URL=https://ntfy.sh
NTFY_TOPIC_PREFIX=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
